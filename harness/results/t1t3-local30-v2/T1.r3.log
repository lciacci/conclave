#!/usr/bin/env python3
"""Divergence analysis: score each query's candidates and compute per-query
divergence metrics (e.g. "how much did they disagree?"). Reuses the same scorer
for all queries, so it's a single call to the grader.

This is the core of the eval pipeline — it's where the "score" comes from.
"""
from __future__ import annotations

import json
import os
import statistics
import sys
from typing import Any

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ensemble import http_call


def analyse(candidates: dict[str, list[dict]], scorer) -> dict[str, Any]:
    """Score each query's candidates and return per-query scores + divergence 
metrics."""
    # For each query, score all its candidates (e.g. 2 for head-to-head)
    # and compute divergence metrics.
    per_query = []
    for qid, cands in candidates.items():
        # Score all candidates for this query
        scores = {}
        for cand in cands:
            content = cand["content"]
            if content is None:
                scores[cand["model"]] = 0.0
            else:
                score = scorer(qid, content)
                scores[cand["model"]] = score
        per_query.append({"query_id": qid, "scores": scores})

    # Compute divergence metrics across all queries
    # (e.g., how much did the models disagree?)
    # For now, just return the raw scores and per-query data
    return {"per_query": per_query}


def print_report(report: dict) -> None:
    """Print a human-readable summary of the analysis."""
    print("\n=================== DIVERGENCE ANALYSIS ===================")
    for r in report["per_query"]:
        qid = r["query_id"]
        scores = r["scores"]
        print(f"  {qid}:")
        for model, score in scores.items():
            print(f"    {model}: {score:.4f}")
    print("===========================================================")
